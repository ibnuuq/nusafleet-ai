# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_DB=nusafleet
POSTGRES_USER=nusafleet_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_RO_PASSWORD=change_me
POSTGRES_PORT=5432

# Agent runtime DB access: read-only role only (schema.sql: nusafleet_ro).
# There is deliberately no admin/write DSN in the app config -- see
# docs/architecture/m1_foundation.md.
DATABASE_URL_RO=postgresql://nusafleet_ro:change_me@localhost:5432/nusafleet

# --- LLM provider selection ---
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# --- Gemini (via OpenRouter -- see docs/architecture/m1_foundation.md) ---
# GeminiProvider calls OpenRouter's OpenAI-compatible API, not the native
# Google AI Studio API. Use an OpenRouter key here, and an OpenRouter-style
# model slug (vendor/model), not a bare native model name.
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash

# --- API ---
API_PORT=8000

# --- Agent artifact storage (allowlisted working dir, not ground truth) ---
ARTIFACT_DIR=./artifacts

# --- Generator ---
RANDOM_SEED=20250101
